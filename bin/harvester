#!/usr/bin/env bash
# Unified CLI wrapper for Threat Information Harvester (Containerized Go build & execution)
set -eo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${DIR}/.." && pwd)"
BIN="${DIR}/information-harvester"

# Load local environment variables if .env exists
if [ -f "${ROOT_DIR}/.env" ]; then
    set -a
    # shellcheck disable=SC1091
    . "${ROOT_DIR}/.env"
    set +a
fi

build_container() {
    echo "==> Building information-harvester inside Docker container (golang:alpine)..." >&2
    docker run --rm \
        -u "$(id -u):$(id -g)" \
        -v "${ROOT_DIR}:/workspace" \
        -w /workspace/backend \
        -e HOME=/tmp \
        -e GOCACHE=/tmp/go-build \
        -e GOPATH=/tmp/go-pkg \
        -e CGO_ENABLED=0 \
        golang:alpine \
        go build -ldflags="-s -w" -o /workspace/bin/information-harvester ./cmd/harvester
    echo "==> Compiled binary: bin/information-harvester" >&2
}

test_container() {
    echo "==> Running Go unit tests inside Docker container (golang:alpine)..." >&2
    docker run --rm \
        -u "$(id -u):$(id -g)" \
        -v "${ROOT_DIR}:/workspace" \
        -w /workspace/backend \
        -e HOME=/tmp \
        -e GOCACHE=/tmp/go-build \
        -e GOPATH=/tmp/go-pkg \
        golang:alpine \
        go test -v ./...
}

case "$1" in
    build)
        build_container
        exit 0
        ;;
    test)
        test_container
        exit 0
        ;;
    clean)
        echo "==> Cleaning local binary..." >&2
        rm -f "$BIN"
        exit 0
        ;;
    *)
        if [ ! -f "$BIN" ]; then
            build_container
        fi
        exec "$BIN" "$@"
        ;;
esac


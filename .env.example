# ==============================================================================
# Threat Information Harvester Environment Configuration
# ==============================================================================

# Notification Sinks & Webhooks
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=

# Notion Knowledge Base Synchronization
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Database & Networking
DATABASE_URL=postgres://postgres:postgres@db:5432/threat_harvester
# External Tor SOCKS5 proxy endpoint (e.g. socks5h://host.docker.internal:9050, socks5h://127.0.0.1:9050, or custom socks5 host)
TOR_PROXY_URL=socks5h://127.0.0.1:9050

# Web UI Administrator Authentication
# Admin login stays disabled while ADMIN_PASSWORD is empty
ADMIN_PASSWORD=
# Optional session signing key (32+ random characters); random per process when empty
SESSION_SECRET=

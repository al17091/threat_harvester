# ==============================================================================
# Threat Information Harvester Environment Configuration
# ==============================================================================

# Google Gemini AI API Key (required for Grounded Search & threat enrichment)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Notification Sinks & Webhooks
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=

# Notion Knowledge Base Synchronization
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Database & Networking
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/information_harvester
TOR_PROXY_URL=socks5h://127.0.0.1:9050

# ==============================================================================
# Threat Information Harvester Environment Configuration
# ==============================================================================

# Notification Sinks & Webhooks
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=

# Notion Knowledge Base Synchronization
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Database & Networking
DATABASE_URL=postgres://postgres:postgres@db:5432/threat_harvester
# External Tor SOCKS5 proxy endpoint (e.g. socks5h://host.docker.internal:9050, socks5h://127.0.0.1:9050, or custom socks5 host)
TOR_PROXY_URL=socks5h://127.0.0.1:9050

# Web UI Administrator Authentication
# Admin login stays disabled while ADMIN_PASSWORD is empty
ADMIN_PASSWORD=
# Optional session signing key (32+ random characters); random per process when empty
SESSION_SECRET=
# Trusted reverse proxies in front of the web service (client address for login rate limiting)
TRUSTED_PROXY_HOPS=0

# Internal API Authentication
# Shared by the web and api services; generate with: openssl rand -hex 32
# While empty, protected API routes return 503
INTERNAL_API_TOKEN=
# Local development only: serve protected API routes without a token (ignored when a token is set)
INTERNAL_API_AUTH_DISABLED=false
# Comma-separated browser origins allowed to call the API directly; empty disables CORS
CORS_ALLOWED_ORIGINS=

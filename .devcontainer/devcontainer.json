{
  "name": "Threat Information Harvester Dev",
  "build": {
    "dockerfile": "../Dockerfile.dev",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "editor.formatOnSave": true
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    }
  },
  "remoteUser": "root",
  "postCreateCommand": "harvester status || true"
}

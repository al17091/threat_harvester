FROM golang:alpine

RUN apk add --no-cache \
    tor \
    curl \
    git \
    jq \
    ca-certificates \
    bash \
    tzdata

WORKDIR /app

COPY . /app/
RUN chmod +x /app/bin/harvester /app/docker/entrypoint-dev.sh && \
    ln -sf /app/bin/harvester /usr/local/bin/harvester

ENV PORT=8000

ENTRYPOINT ["/app/docker/entrypoint-dev.sh"]
CMD ["bash"]

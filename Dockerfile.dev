FROM golang:alpine

RUN apk add --no-cache \
    curl \
    git \
    jq \
    ca-certificates \
    bash \
    tzdata

WORKDIR /app

COPY . /app/
RUN cp /app/config.example.yaml /app/config.yaml && \
    chmod +x /app/scripts/harvester.sh && \
    ln -sf /app/scripts/harvester.sh /usr/local/bin/harvester

ENV PORT=8000

CMD ["bash"]
